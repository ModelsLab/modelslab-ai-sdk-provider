{
  "name": "@modelslab/ai-sdk-provider",
  "version": "0.1.0",
  "description": "ModelsLab provider for the Vercel AI SDK: image generation with Flux, SDXL, Imagen and thousands more models via the ModelsLab API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai",
    "provider",
    "modelslab",
    "image-generation",
    "text-to-image",
    "flux"
  ],
  "homepage": "https://github.com/ModelsLab/modelslab-ai-sdk-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ModelsLab/modelslab-ai-sdk-provider.git"
  },
  "bugs": {
    "url": "https://github.com/ModelsLab/modelslab-ai-sdk-provider/issues"
  },
  "author": "ModelsLab",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.21",
    "@ai-sdk/provider-utils": "^5.0.53"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ai": "^7.0.127",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
